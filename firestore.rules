rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user has valid UWO email
    function isUWOUser() {
      return request.auth != null && 
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@uwo\\.ca$');
    }

    match /events_test/{eventId} {
      allow read;
      allow create, update, delete: if request.auth != null && request.auth.uid == "YFJw0QC8QRTC0qiiZH6rSiD8Rkg2";
    }

    match /events_prod/{eventId} {
      allow read;
      allow create, update, delete: if request.auth != null && request.auth.uid == "YFJw0QC8QRTC0qiiZH6rSiD8Rkg2";
    }

    match /users/{userId} {
      allow read: if isUWOUser();
      allow create: if isUWOUser();
      allow update: if isUWOUser() && request.auth.uid == userId;
    }

    match /carpools_prod/{carpool} {
      allow read: if isUWOUser();
      allow create: if isUWOUser() && request.auth.uid == request.resource.data.userId;
      allow update: if isUWOUser() && (
        // Owner can update any field
        (request.auth.uid == resource.data.userId) ||
        // Non-owners can join directly if status is Open
        (request.auth.uid != resource.data.userId && resource.data.status == "Open" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people'])) ||
        // Non-owners can request to join if status is RequestToJoin
        (request.auth.uid != resource.data.userId && resource.data.status == "RequestToJoin" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests']))
      );
      allow delete: if isUWOUser() && request.auth.uid == resource.data.userId;
    }

    match /carpools_test/{carpool} {
      allow read: if isUWOUser();
      allow create: if isUWOUser() && request.auth.uid == request.resource.data.userId;
      allow update: if isUWOUser() && (
        // Owner can update any field
        (request.auth.uid == resource.data.userId) ||
        // Non-owners can join directly if status is Open
        (request.auth.uid != resource.data.userId && resource.data.status == "Open" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people'])) ||
        // Non-owners can request to join if status is RequestToJoin
        (request.auth.uid != resource.data.userId && resource.data.status == "RequestToJoin" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])) ||
        // Allow updating 'people' if current user is in the carpool
        (resource.data.people.hasAny([request.auth.uid]) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['people']))
      );
      allow delete: if isUWOUser() && request.auth.uid == resource.data.userId;
    }
  }
}